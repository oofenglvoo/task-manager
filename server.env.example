# 部署配置模板：复制为 server.env 后修改，server.env 不会被提交到仓库。
#
# 账号（三项都必填，缺任意一项后端会直接报错退出）
TASK_APP_USERNAME=admin
TASK_APP_PASSWORD=change-me
# 签名密钥：请替换为足够长的随机字符串。改动它会让所有人重新登录。
TASK_SECRET_KEY=replace-with-a-long-random-string
# 登录态有效期（天）
TASK_TOKEN_DAYS=30

# 监听地址与端口（start-server.bat 会读取；命令行参数可覆盖）
# 0.0.0.0 表示允许从其他机器访问
APP_HOST=0.0.0.0
APP_PORT=8001

# 数据库路径（可选，默认 data/tasks.db；上传的背景图会保存在同目录的 backgrounds/ 下）
# TASK_DB_PATH=D:\task-manager\data\tasks.db
